generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  UPI
  CARD
  CASH
  WALLET
  NETBANKING
}

enum Cuisine {
  NORTH_INDIAN
  SOUTH_INDIAN
  CHINESE
  BIRYANI
  PIZZA
  BURGER
  DESSERT
  BEVERAGES
  STREET_FOOD
  CONTINENTAL
  THAI
  HEALTHY
  BAKERY
  MUGHLAI
  ANDHRA
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String
  avatarUrl String?
  createdAt DateTime         @default(now())
  orders    Order[]
  analytics AnalyticsCache[]
}

model Restaurant {
  id       String  @id @default(cuid())
  name     String
  cuisine  Cuisine
  area     String
  city     String
  rating   Float?
  imageUrl String?
  orders   Order[]

  @@index([cuisine])
  @@index([city])
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  restaurantId  String
  placedAt      DateTime
  deliveredAt   DateTime?
  subtotal      Int
  deliveryFee   Int
  packagingFee  Int
  taxes         Int
  discount      Int           @default(0)
  total         Int
  paymentMethod PaymentMethod
  rating        Int?
  user          User          @relation(fields: [userId], references: [id])
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  items         OrderItem[]

  @@index([userId, placedAt])
  @@index([restaurantId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  name      String
  quantity  Int
  unitPrice Int
  isVeg     Boolean @default(true)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model AnalyticsCache {
  id         String   @id @default(cuid())
  userId     String
  key        String
  payload    Json
  computedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}
